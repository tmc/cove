+			return fmt.Errorf("create PL011 output: %w", err)
+		}
+		port := vz.VZSerialPortConfigurationFromID(serial.ID)
+		port.SetAttachment(attachment)
+		config.SetSerialPorts([]vz.VZSerialPortConfiguration{port})
+	}
